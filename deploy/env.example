NODE_ENV=production
DATABASE_URL=postgres://affigrove:REPLACE_ON_THE_SERVER@127.0.0.1:5432/affigrove
# Private library for files uploaded after a manual Muse session. Not a public URL.
# AFFIGROVE_MEDIA_DIR=/var/lib/affigrove/media
# Private FreeLLMAPI router. Loopback only. The value is the router's unified key, not a provider key.
# FREELLMAPI_API_KEY=
# FREELLMAPI_MODEL=openai/gpt-oss-120b
# FREELLMAPI_FALLBACK_MODEL=openai/gpt-oss-20b
# FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
# Novita remains available when FreeLLMAPI is unset. Leave unset until the owner supplies a key and a model id.
# NOVITA_API_KEY=
# NOVITA_MODEL=
# NOVITA_BASE_URL=https://api.novita.ai/openai
# Authorised search. Leave unset until a provider and key exist. Novita is not a search API.
# RESEARCH_PROVIDER=
# RESEARCH_API_KEY=
